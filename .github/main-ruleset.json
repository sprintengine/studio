{
  "name": "Main requires conventional merges",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Conventional PR title", "integration_id": 15368 },
          { "context": "Build (ubuntu-latest)", "integration_id": 15368 },
          { "context": "Build (windows-latest)", "integration_id": 15368 },
          { "context": "Build (macos-latest)", "integration_id": 15368 },
          { "context": "JS tests (ubuntu-latest)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
