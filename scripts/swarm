#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

if [[ -x "$REPO_ROOT/.venv/bin/python" ]]; then
  exec "$REPO_ROOT/.venv/bin/python" "$SCRIPT_DIR/sprintengine_tool.py" "$@"
fi

if [[ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]]; then
  exec "$REPO_ROOT/.venv/Scripts/python.exe" "$SCRIPT_DIR/sprintengine_tool.py" "$@"
fi

exec python3 "$SCRIPT_DIR/sprintengine_tool.py" "$@"
