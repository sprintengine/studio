{
  "schemaVersion": 1,
  "name": "sprintengine-studio",
  "version": "0.2.0",
  "summary": "SprintEngine Studio design system: neutral two-tier selection, one accent reserved for the primary action, a 2px-grid spacing scale, and progressive disclosure of row actions.",
  "modes": [
    "light",
    "dark"
  ],
  "namingGrammar": {
    "tokens": "<tier>.<group...>.<name> — tier is 'ref' or 'sem'; every segment is lowercase kebab-case; nesting follows DTCG groups; aliases reference the full dotted path as {tier.group.name}",
    "cssVariables": "'--' plus the token path with '.' replaced by '-' (sem.color.bg.app -> --sem-color-bg-app); components consume only the --sem-* set",
    "components": "kebab-case directory under components/, containing component.html, component.css, and component.md",
    "glyphs": "kebab-case concept name, one concept per SVG; strokes and fills use currentColor"
  },
  "contents": {
    "foundations": [
      "foundations/tokens.tokens.json",
      "foundations/principles.md"
    ],
    "components": [
      "badge",
      "banner",
      "board-lane",
      "button",
      "card-button",
      "check-row",
      "checkbox",
      "chip-button",
      "command-palette",
    "context-ring",
      "definition-list",
      "drawer",
      "empty-state",
      "extension-icon",
      "field",
      "file-tree",
      "glyphs",
      "group-header",
      "inbox-row",
      "inline-notice",
      "input",
      "kbd-chord",
      "link-button",
      "list-row",
      "liveness",
      "menu",
      "menu-option",
      "micro-chip",
      "modal",
      "pager",
      "panel-header",
      "popover",
      "provider-row",
      "row-button",
      "section",
      "segmented-control",
      "scope-pill",
      "select",
      "setting-row",
      "side-pane",
      "skeleton",
      "slider",
      "spinner",
      "split-button",
      "status-dot",
      "switch",
      "table",
      "tabs",
      "task-card",
      "toast",
      "toolbar",
      "tooltip",
      "trigger-button",
      "truncated-text",
      "working-edge",
      "workspace-panel"
    ],
    "patterns": [
      "patterns/context-rail.html",
      "patterns/list-surface.html",
      "patterns/selection.html"
    ],
    "glyphs": [
