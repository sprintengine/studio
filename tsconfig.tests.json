{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "packages/module-sdk/src/**/*.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
