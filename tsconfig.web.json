{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "packages/conversation-protocol/src/**/*.ts",
    "packages/studio-protocol/src/**/*.ts",
    "packages/agent-sdk/src/index.ts",
    "packages/agent-sdk/src/client.ts",
    "packages/agent-sdk/src/conversations.ts",
    "packages/agent-sdk/src/errors.ts",
    "packages/agent-sdk/src/module.ts",
    "packages/agent-sdk/src/protocol.ts",
    "packages/agent-sdk/src/transport.ts",
    "packages/agent-sdk/src/tools.ts",
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "packages/module-sdk/src/index.ts",
    "packages/module-sdk/src/manifest-validate.ts",
    "packages/module-sdk/src/plugin-manifest.ts",
    "packages/module-sdk/src/host-api.ts",
    "packages/module-sdk/src/conversation.ts",
    "packages/module-sdk/src/brokers.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "compilerOptions": {
    "composite": true,
    // @electron-toolkit/tsconfig turns noImplicitAny OFF after setting strict, so
    // every un-annotated parameter was silently `any` until this line. Kept here
    // rather than in the vendored base, which npm rewrites.
    "noImplicitAny": true,
    // The canvas editor (`@excalidraw/excalidraw`) publishes its types only
    // through its `exports` map, so `node`/`node10` resolution cannot see
    // either the package or its `/types` subpath. The renderer is bundled by
    // Vite, which resolves exactly this way; the other two projects already do.
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
