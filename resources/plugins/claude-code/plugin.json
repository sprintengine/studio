{
  "id": "claude-code",
  "displayName": "Claude Code",
  "publisher": "anthropic",
  "version": 1,
  "summary": "Anthropic's Claude Code coding agent, driven in a terminal.",
  "category": "Agent CLI",
  "icon": "icon.svg",
  "binary": "claude",
  "permissionPresets": {
    "default": {
      "label": "Default (Claude prompts for permissions)",
      "args": []
    },
    "auto_workspace": {
      "label": "Auto-approve workspace edits",
      "args": ["--permission-mode", "auto"]
    },
    "bypass_all": {
      "label": "Bypass all approvals (dangerous)",
      "args": ["--permission-mode", "bypassPermissions"]
    }
  },
  "modelSelection": {
    "args": ["--model", "{{model}}"],
    "options": [
      { "id": "claude-opus-5", "label": "Opus 5" },
      { "id": "claude-opus-5[1m]", "label": "Opus 5 (1M context)" },
      { "id": "opus[1m]", "label": "Opus (latest, 1M context)" },
      { "id": "claude-fable-5", "label": "Fable 5" }
    ],
    "allowCustomId": true
  },
  "reasoningSelection": {
    "$comment": "claude --effort <level>, documented in --help on CLI 2.1.220. No default is declared: the CLI's own default effort is undocumented, so declaring one would have to be a guess, and an incorrect guess silently changes launches. Omitting it means a blank selection passes no flag and every explicitly picked level does.",
    "args": ["--effort", "{{reasoning}}"],
    "levels": [
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium" },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra high" },
      { "id": "max", "label": "Max" }
    ]
  },
  "themeSelection": {
    "args": ["--settings", "{\"theme\":\"{{colorScheme}}\"}"]
  },
  "launch": {
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "modelArgs" },
      { "spreadIf": "reasoningArgs" },
      { "spreadIf": "themeArgs" },
      "--session-id",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "resume": {
    "supported": true,
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "themeArgs" },
      "--resume",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "promptInjection": {
    "mode": "positional-arg"
  },
  "completion": {
    "mode": "process-exit"
  },
  "mcpConfig": {
    "path": "{{workspaceRoot}}/.mcp.json",
    "format": "claude-code"
  },
  "skillIntegration": {
    "support": "native",
    "harnessId": "claude",
    "installTargets": [
      {
        "scope": "workspace",
        "path": "{{workspaceRoot}}/.claude/skills/{{skillId}}",
        "format": "claude-code",
        "$comment": "restartRequired verified false on 2026-07-29: a skill directory created while `claude` was already running appeared in its /skill picker without a restart. kimi-claude and zai run the same `claude` binary against the same .claude/skills, so the finding covers all three.",
        "restartRequired": false
      }
    ],
    "invocation": {
      "fileDropTemplate": "/{{skillId}} {{path}}",
      "explicitTemplate": "/{{skillId}}",
      "nativeSlashCommand": true,
      "mentionPrefix": "/"
    }
  },
  "agentStateSpec": {
    "$comment": "Authoritative agent-state via Claude Code lifecycle hooks, merged as tagged entries into the workspace settings. PreToolUse is register:false deliberately: PreToolUse and PostToolUse fire once per tool call each, and PostToolUse alone is load-bearing (its thinking frame is the only signal that clears awaiting_input after a permission is answered), so registering only PostToolUse halves the per-tool reporter spawns. The Notification allow-list keeps informational types (idle_prompt, auth_success, elicitation_complete/response, agent_completed — documented set as of 2026-07-08) from parking a session as falsely needs-input forever (the 2026-07-07 incident); if a future Claude build adds a new BLOCKING notification_type, extend oneOf here.",
    "registration": { "kind": "settings-json", "path": ".claude/settings.local.json" },
    "events": [
      { "event": "SessionStart", "phase": "starting" },
      { "event": "UserPromptSubmit", "phase": "thinking" },
      { "event": "PreToolUse", "phase": "tool_use", "register": false },
      { "event": "PostToolUse", "matcher": "*", "phase": "thinking" },
      {
        "event": "Notification",
        "phase": "awaiting_input",
        "when": { "field": "notificationType", "oneOf": ["permission_prompt", "elicitation_dialog", "agent_needs_input"] }
      },
      { "event": "Stop", "phase": "idle", "turnEnd": true },
      { "event": "SubagentStop", "phase": "idle" },
      { "event": "SessionEnd", "phase": "exited" }
    ]
  },
  "detect": {
    "versionArgs": ["--version"]
  },
  "update": {
    "args": ["update"]
  },
  "install": {
    "darwin": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "linux": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "wsl": [
      {
        "id": "official",
        "label": "Official installer in WSL (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm in WSL (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "win32": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "irm https://claude.ai/install.ps1 | iex",
        "recommended": true
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ]
  },
  "capabilities": {
    "resumeSession": true,
    "sessionIdFromCaller": true,
    "toolUse": true,
    "mcpServers": true
  }
}
