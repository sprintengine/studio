{
  "id": "claude-code",
  "displayName": "Claude Code",
  "publisher": "anthropic",
  "version": 1,
  "binary": "claude",
  "permissionPresets": {
    "default": {
      "label": "Default (Claude prompts for permissions)",
      "args": []
    },
    "auto_workspace": {
      "label": "Auto-approve workspace edits",
      "args": ["--permission-mode", "auto"]
    },
    "bypass_all": {
      "label": "Bypass all approvals (dangerous)",
      "args": ["--permission-mode", "bypassPermissions"]
    }
  },
  "modelSelection": {
    "args": ["--model", "{{model}}"],
    "options": [
      { "id": "claude-opus-4-8", "label": "Opus 4.8" },
      { "id": "fable", "label": "Fable 5" },
      { "id": "claude-opus-4-7", "label": "Opus 4.7" },
      { "id": "claude-sonnet-4-6", "label": "Sonnet 4.6" },
      { "id": "claude-haiku-4-5", "label": "Haiku 4.5" }
    ],
    "allowCustomId": true
  },
  "themeSelection": {
    "args": ["--settings", "{\"theme\":\"{{colorScheme}}\"}"]
  },
  "launch": {
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "modelArgs" },
      { "spreadIf": "themeArgs" },
      "--session-id",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "resume": {
    "supported": true,
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "themeArgs" },
      "--resume",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "promptInjection": {
    "mode": "positional-arg"
  },
  "completion": {
    "mode": "process-exit"
  },
  "mcpConfig": {
    "path": "{{workspaceRoot}}/.mcp.json",
    "format": "claude-code"
  },
  "skillIntegration": {
    "support": "native",
    "harnessId": "claude",
    "installTargets": [
      {
        "scope": "workspace",
        "path": "{{workspaceRoot}}/.claude/skills/{{skillId}}",
        "format": "claude-code",
        "restartRequired": true
      }
    ],
    "invocation": {
      "fileDropTemplate": "/{{skillId}} {{path}}",
      "explicitTemplate": "/{{skillId}}",
      "nativeSlashCommand": true
    }
  },
  "detect": {
    "versionArgs": ["--version"]
  },
  "install": {
    "darwin": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "linux": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "wsl": [
      {
        "id": "official",
        "label": "Official installer in WSL (recommended)",
        "shell": "curl -fsSL https://claude.ai/install.sh | bash",
        "recommended": true,
        "requires": "curl"
      },
      {
        "id": "npm",
        "label": "npm in WSL (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ],
    "win32": [
      {
        "id": "official",
        "label": "Official installer (recommended)",
        "shell": "irm https://claude.ai/install.ps1 | iex",
        "recommended": true
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @anthropic-ai/claude-code",
        "requires": "npm"
      }
    ]
  },
  "capabilities": {
    "resumeSession": true,
    "sessionIdFromCaller": true,
    "toolUse": true,
    "mcpServers": true
  }
}
