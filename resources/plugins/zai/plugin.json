{
  "id": "zai",
  "displayName": "Z.AI",
  "publisher": "multicode",
  "version": 1,
  "summary": "GLM through the Claude Code CLI, pointed at Z.AI's endpoint.",
  "category": "Agent CLI",
  "icon": "icon.svg",
  "binary": "claude",
  "auth": {
    "type": "api-key",
    "label": "Z.AI API key",
    "env": "ANTHROPIC_AUTH_TOKEN"
  },
  "permissionPresets": {
    "manual": {
      "label": "Manual — ask before every action",
      "args": ["--permission-mode", "default"]
    },
    "auto": {
      "$comment": "Claude Code's auto mode: a second model (the classifier) reviews each action before it runs instead of the user. NOT workspace-scoped \u2014 the preset this replaced was labelled \"Auto-approve workspace edits\", which described Codex's sandbox rung and misdescribed this one (MC-2210). Reads and in-project edits skip the classifier; shell, network, out-of-project writes and subagent spawns are reviewed.",
      "label": "Auto — the classifier reviews each action",
      "args": ["--permission-mode", "auto"]
    },
    "bypass": {
      "label": "Bypass all approvals (dangerous)",
      "args": ["--permission-mode", "bypassPermissions"]
    }
  },
  "themeSelection": {
    "args": ["--settings", "{\"theme\":\"{{colorScheme}}\"}"]
  },
  "launch": {
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "themeArgs" },
      "--session-id",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ],
    "env": {
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "ANTHROPIC_AUTH_TOKEN": "{{secret}}",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.2",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.7"
    }
  },
  "resume": {
    "supported": true,
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "themeArgs" },
      "--resume",
      "{{sessionId}}",
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "promptInjection": {
    "mode": "positional-arg"
  },
  "completion": {
    "mode": "process-exit"
  },
  "mcpConfig": {
    "path": "{{workspaceRoot}}/.mcp.json",
    "format": "claude-code"
  },
  "skillIntegration": {
    "support": "native",
    "harnessId": "claude",
    "installTargets": [
      {
        "scope": "workspace",
        "path": "{{workspaceRoot}}/.claude/skills/{{skillId}}",
        "format": "claude-code",
        "$comment": "restartRequired verified false on 2026-07-29: a skill directory created while `claude` was already running appeared in its /skill picker without a restart. kimi-claude and zai run the same `claude` binary against the same .claude/skills, so the finding covers all three.",
        "restartRequired": false
      }
    ],
    "invocation": {
      "fileDropTemplate": "/{{skillId}} {{path}}",
      "explicitTemplate": "/{{skillId}}",
      "nativeSlashCommand": true,
      "mentionPrefix": "/"
    }
  },
  "agentStateSpec": {
    "$comment": "Byte-for-byte the claude-code spec: this runtime is the same `claude` binary against a redirected endpoint, so it fires the same lifecycle hooks and shares the same .claude/settings.local.json registration. Formerly admitted by a harnessId fallback in core; declared here so the capability is explicit per plugin.",
    "registration": { "kind": "settings-json", "path": ".claude/settings.local.json" },
    "events": [
      { "event": "SessionStart", "phase": "starting" },
      { "event": "UserPromptSubmit", "phase": "thinking" },
      { "event": "PreToolUse", "phase": "tool_use", "register": false },
      { "event": "PostToolUse", "matcher": "*", "phase": "thinking" },
      {
        "event": "Notification",
        "phase": "awaiting_input",
        "when": { "field": "notificationType", "oneOf": ["permission_prompt", "elicitation_dialog", "agent_needs_input"] }
      },
      { "event": "Stop", "phase": "idle", "turnEnd": true },
      { "event": "SubagentStop", "phase": "idle" },
      { "event": "SessionEnd", "phase": "exited" }
    ]
  },
  "detect": {
    "versionArgs": ["--version"]
  },
  "capabilities": {
    "resumeSession": true,
    "sessionIdFromCaller": true,
    "toolUse": true,
    "mcpServers": true
  }
}
