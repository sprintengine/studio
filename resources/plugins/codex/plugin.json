{
  "id": "codex",
  "displayName": "Codex",
  "publisher": "openai",
  "version": 1,
  "binary": "codex",
  "permissionPresets": {
    "default": {
      "label": "Default (Codex prompts for permissions)",
      "args": []
    },
    "auto_workspace": {
      "label": "Auto-approve workspace edits",
      "args": ["--ask-for-approval", "never", "--sandbox", "workspace-write"]
    },
    "bypass_all": {
      "label": "Bypass all approvals (dangerous)",
      "args": ["--dangerously-bypass-approvals-and-sandbox"]
    }
  },
  "modelSelection": {
    "args": ["--model", "{{model}}"],
    "options": [
      { "id": "gpt-5.6-sol", "label": "GPT-5.6 Sol" },
      { "id": "gpt-5.6-terra", "label": "GPT-5.6 Terra" },
      { "id": "gpt-5.6-luna", "label": "GPT-5.6 Luna" },
      { "id": "gpt-5.5", "label": "GPT-5.5" },
      { "id": "gpt-5.4", "label": "GPT-5.4" },
      { "id": "gpt-5.4-mini", "label": "GPT-5.4 Mini" }
    ],
    "allowCustomId": true
  },
  "themeSelection": {
    "args": ["-c", "tui.theme=\"{{themeName}}\""],
    "schemes": { "light": "catppuccin-latte", "dark": "catppuccin-mocha" }
  },
  "launch": {
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "modelArgs" },
      { "spreadIf": "themeArgs" },
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "resume": {
    "supported": true,
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "themeArgs" },
      "resume",
      { "valueIf": "sessionId", "value": "{{sessionId}}" }
    ]
  },
  "promptInjection": {
    "mode": "positional-arg"
  },
  "completion": {
    "mode": "process-exit"
  },
  "mcpConfig": {
    "path": "{{workspaceRoot}}/.codex/config.toml",
    "userPath": "{{home}}/.codex/config.toml",
    "format": "codex"
  },
  "skillIntegration": {
    "support": "native",
    "harnessId": "codex",
    "installTargets": [
      {
        "scope": "workspace",
        "path": "{{workspaceRoot}}/.codex/skills/{{skillId}}",
        "format": "codex",
        "restartRequired": true
      }
    ],
    "invocation": {
      "fileDropTemplate": "Use ${{skillId}} to work {{path}}.",
      "explicitTemplate": "Use ${{skillId}}.",
      "explicitMention": true,
      "implicitInvocation": true
    }
  },
  "detect": {
    "versionArgs": ["--version"]
  },
  "install": {
    "darwin": [
      {
        "id": "brew",
        "label": "Homebrew (recommended)",
        "shell": "brew install codex",
        "recommended": true,
        "requires": "brew"
      },
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @openai/codex",
        "requires": "npm"
      }
    ],
    "linux": [
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @openai/codex",
        "recommended": true,
        "requires": "npm"
      }
    ],
    "wsl": [
      {
        "id": "npm",
        "label": "npm in WSL (requires Node.js)",
        "shell": "npm install -g @openai/codex",
        "recommended": true,
        "requires": "npm"
      }
    ],
    "win32": [
      {
        "id": "npm",
        "label": "npm (requires Node.js)",
        "shell": "npm install -g @openai/codex",
        "recommended": true,
        "requires": "npm"
      }
    ]
  },
  "capabilities": {
    "resumeSession": true,
    "sessionIdFromCaller": false,
    "toolUse": true,
    "mcpServers": true
  }
}
