{
  "id": "codex",
  "displayName": "Codex",
  "publisher": "openai",
  "version": 1,
  "binary": "codex",
  "permissionPresets": {
    "default": {
      "label": "Default (Codex prompts for permissions)",
      "args": []
    },
    "auto_workspace": {
      "label": "Auto-approve workspace edits",
      "args": ["--ask-for-approval", "never", "--sandbox", "workspace-write"]
    },
    "bypass_all": {
      "label": "Bypass all approvals (dangerous)",
      "args": ["--dangerously-bypass-approvals-and-sandbox"]
    }
  },
  "modelSelection": {
    "args": ["--model", "{{model}}"],
    "options": [
      { "id": "gpt-5.5", "label": "GPT-5.5" },
      { "id": "gpt-5.4", "label": "GPT-5.4" },
      { "id": "gpt-5.4-mini", "label": "GPT-5.4 Mini" },
      { "id": "gpt-5.3-codex", "label": "GPT-5.3 Codex" }
    ],
    "allowCustomId": true
  },
  "launch": {
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      { "spreadIf": "modelArgs" },
      { "valueIf": "prompt", "value": "{{prompt}}" }
    ]
  },
  "resume": {
    "supported": true,
    "argv": [
      "{{binary}}",
      { "spreadIf": "permissionArgs" },
      "resume"
    ]
  },
  "promptInjection": {
    "mode": "positional-arg"
  },
  "completion": {
    "mode": "process-exit"
  },
  "mcpConfig": {
    "path": "{{workspaceRoot}}/.codex/config.toml",
    "userPath": "{{home}}/.codex/config.toml",
    "format": "codex"
  },
  "skillIntegration": {
    "support": "native",
    "harnessId": "codex",
    "installTargets": [
      {
        "scope": "workspace",
        "path": "{{workspaceRoot}}/.codex/skills/{{skillId}}",
        "format": "codex",
        "restartRequired": true
      }
    ],
    "invocation": {
      "fileDropTemplate": "Use ${{skillId}} to work {{path}}.",
      "explicitTemplate": "Use ${{skillId}}.",
      "explicitMention": true,
      "implicitInvocation": true
    }
  },
  "capabilities": {
    "resumeSession": true,
    "sessionIdFromCaller": false,
    "toolUse": true,
    "mcpServers": true
  }
}
