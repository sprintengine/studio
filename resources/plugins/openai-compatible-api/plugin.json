{
  "kind": "provider",
  "id": "openai-compatible-api",
  "displayName": "OpenAI Compatible API",
  "publisher": "multicode",
  "version": 1,
  "providerType": "model-provider",
  "models": [
    {
      "id": "gpt-4o-mini",
      "displayName": "GPT-4o mini"
    },
    {
      "id": "gpt-4o",
      "displayName": "GPT-4o"
    }
  ],
  "auth": {
    "type": "api-key",
    "label": "API key",
    "env": "OPENAI_API_KEY"
  },
  "adapter": {
    "kind": "declarative"
  },
  "openaiCompatible": {
    "baseUrl": "https://api.openai.com",
    "chatCompletionsPath": "/v1/chat/completions"
  }
}
