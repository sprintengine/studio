{
  "id": "generic-shell",
  "displayName": "Generic Shell",
  "publisher": "sprintengine",
  "version": 1,
  "summary": "A bare shell runtime for driving any command-line program as an agent.",
  "category": "Agent CLI",
  "icon": "icon.svg",
  "binary": "sh",
  "permissionPresets": {
    "manual": {
      "label": "Manual",
      "args": []
    }
  },
  "launch": {
    "argv": ["{{binary}}"]
  },
  "promptInjection": {
    "mode": "stdin-pipe"
  },
  "completion": {
    "mode": "process-exit"
  },
  "skillIntegration": {
    "support": "unsupported",
    "harnessId": "generic-shell"
  },
  "capabilities": {
    "resumeSession": false,
    "sessionIdFromCaller": false,
    "toolUse": false,
    "mcpServers": false
  }
}
