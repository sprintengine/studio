{
  "name": "multicode",
  "version": "0.1.5",
  "description": "AI-first IDE and agent sprintengine command center",
  "main": "./out/main/index.js",
  "homepage": ".",
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build && node scripts/check-bundle-budget.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "npm run typecheck:app",
    "typecheck:app": "tsc -b --noEmit --verbose",
    "typecheck:tests": "tsc -b tsconfig.tests.json --noEmit --verbose",
    "typecheck:all": "npm run typecheck:app && npm run typecheck:tests",
    "test:renderer:markdown": "esbuild src/renderer/src/utils/markdown.test.tsx --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/markdown.test.cjs && node node_modules/.cache/multicode/markdown.test.cjs",
    "test:renderer:switchboard-board": "esbuild src/renderer/src/utils/switchboardBoard.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/switchboardBoard.test.cjs && node node_modules/.cache/multicode/switchboardBoard.test.cjs",
    "test:main:builtin-skills": "esbuild src/main/builtin-skills.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/builtin-skills.test.cjs && node node_modules/.cache/multicode/builtin-skills.test.cjs",
    "test:main:git-branch-actions": "esbuild src/main/git-branch-actions.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/git-branch-actions.test.cjs && node node_modules/.cache/multicode/git-branch-actions.test.cjs",
    "test:main:mcp-config": "esbuild src/main/mcp-config-service.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/mcp-config-service.test.cjs && node node_modules/.cache/multicode/mcp-config-service.test.cjs",
    "test:main:sprintengine-role-registry": "esbuild src/main/sprintengine-role-registry.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/sprintengine-role-registry.test.cjs && node node_modules/.cache/multicode/sprintengine-role-registry.test.cjs",
    "test:shared:role-manifest": "esbuild src/shared/sprintengine/role-manifest.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/role-manifest.test.cjs && node node_modules/.cache/multicode/role-manifest.test.cjs",
    "test:shared:layout-template-manifest": "esbuild src/shared/layouts/template-manifest.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/layout-template-manifest.test.cjs && node node_modules/.cache/multicode/layout-template-manifest.test.cjs",
    "test:main:layout-template-registry": "esbuild src/main/layout-template-registry.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/layout-template-registry.test.cjs && node node_modules/.cache/multicode/layout-template-registry.test.cjs",
    "test:main:sprintengine-mcp-hub": "esbuild src/main/sprintengine-mcp-hub.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/sprintengine-mcp-hub.test.cjs && node node_modules/.cache/multicode/sprintengine-mcp-hub.test.cjs",
    "test:main:sprintengine-artifacts": "esbuild src/main/sprintengine-artifacts.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/sprintengine-artifacts.test.cjs && node node_modules/.cache/multicode/sprintengine-artifacts.test.cjs",
    "test:main:switchboard-ipc": "esbuild src/main/ipc/switchboard-ipc.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/switchboard-ipc.test.cjs && node node_modules/.cache/multicode/switchboard-ipc.test.cjs",
    "test:main:terminal-runtime": "esbuild src/main/terminal-runtime.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/terminal-runtime.test.cjs && node node_modules/.cache/multicode/terminal-runtime.test.cjs",
    "test:main:terminal-session": "esbuild src/main/terminal-session.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/terminal-session.test.cjs && node node_modules/.cache/multicode/terminal-session.test.cjs",
    "test:main:plugin-render": "esbuild src/main/plugin-render.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/plugin-render.test.cjs && node node_modules/.cache/multicode/plugin-render.test.cjs",
    "test:main:plugin-registry": "esbuild src/main/plugin-registry.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/plugin-registry.test.cjs && node node_modules/.cache/multicode/plugin-registry.test.cjs",
    "test:main:module-host": "esbuild src/main/module-host/load-modules.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/module-host.test.cjs && node node_modules/.cache/multicode/module-host.test.cjs",
    "test:main:module-enablement": "esbuild src/main/module-host/enablement-store.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/module-enablement.test.cjs && node node_modules/.cache/multicode/module-enablement.test.cjs",
    "test:shared:module-resolve": "esbuild src/shared/modules/resolve.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/module-resolve.test.cjs && node node_modules/.cache/multicode/module-resolve.test.cjs",
    "test:shared:module-permissions": "esbuild src/shared/modules/permissions.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/module-permissions.test.cjs && node node_modules/.cache/multicode/module-permissions.test.cjs",
    "test:renderer:bundled-ids": "esbuild src/renderer/src/modules/bundled-ids.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/bundled-ids.test.cjs && node node_modules/.cache/multicode/bundled-ids.test.cjs",
    "test:shared:third-party-manifest": "esbuild src/shared/modules/third-party-manifest.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/third-party-manifest.test.cjs && node node_modules/.cache/multicode/third-party-manifest.test.cjs",
    "test:main:module-signature": "esbuild src/main/modules/module-signature.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/module-signature.test.cjs && node node_modules/.cache/multicode/module-signature.test.cjs",
    "test:main:user-module-registry": "esbuild src/main/modules/user-module-registry.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/user-module-registry.test.cjs && node node_modules/.cache/multicode/user-module-registry.test.cjs",
    "test:main:trust-store": "esbuild src/main/modules/trust-store.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/trust-store.test.cjs && node node_modules/.cache/multicode/trust-store.test.cjs",
    "test:main:agent-launch-render": "esbuild src/main/agent-launch-render.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/agent-launch-render.test.cjs && node node_modules/.cache/multicode/agent-launch-render.test.cjs",
    "test:main:agent-stream-watcher": "esbuild src/main/agent-stream-watcher.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/agent-stream-watcher.test.cjs && node node_modules/.cache/multicode/agent-stream-watcher.test.cjs",
    "test:main:souls-service": "esbuild src/main/souls-service.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/souls-service.test.cjs && node node_modules/.cache/multicode/souls-service.test.cjs",
    "test:main:mobile-sprintengine-command": "esbuild src/main/mobile/sprintengine/command.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/mobile-sprintengine-command.test.cjs && node node_modules/.cache/multicode/mobile-sprintengine-command.test.cjs",
    "test:renderer:terminal-sessions": "esbuild src/renderer/src/hooks/useTerminalSessions.test.ts --bundle --platform=node --format=cjs --packages=external --define:import.meta.env.DEV=false --outfile=node_modules/.cache/multicode/terminal-sessions.test.cjs && node node_modules/.cache/multicode/terminal-sessions.test.cjs",
    "test:renderer:sprintengine-auto-run": "esbuild src/renderer/src/utils/sprintengineAutoRun.test.ts --bundle --platform=node --format=cjs --packages=bundle --external:react --external:react-dom --define:import.meta.env.DEV=false --define:import.meta.env.VITE_MULTICODE_SAFE_MODE='\"0\"' --define:import.meta.env.VITE_MULTICODE_DISABLE_SPRINTENGINE_AUTORUN='\"0\"' --define:import.meta.env.VITE_MULTICODE_DISABLE_SPRINTENGINE_SYNC='\"0\"' --define:import.meta.env.VITE_MULTICODE_DISABLE_SPRINTENGINE_TERMINALS='\"0\"' --loader:.css=empty --outfile=node_modules/.cache/multicode/sprintengine-auto-run.test.cjs && node node_modules/.cache/multicode/sprintengine-auto-run.test.cjs",
    "test:renderer:sprintengine-auto-run-executor": "esbuild src/renderer/src/utils/sprintengineAutoRunExecutor.test.ts --bundle --platform=node --format=cjs --packages=bundle --external:react --external:react-dom --define:import.meta.env.DEV=false --loader:.css=empty --outfile=node_modules/.cache/multicode/sprintengine-auto-run-executor.test.cjs && node node_modules/.cache/multicode/sprintengine-auto-run-executor.test.cjs",
    "test:renderer:sprintengine": "esbuild src/renderer/src/utils/sprintengine.test.ts --bundle --platform=node --format=cjs --packages=bundle --external:react --external:react-dom --define:import.meta.env.DEV=false --loader:.css=empty --outfile=node_modules/.cache/multicode/sprintengine.test.cjs && node node_modules/.cache/multicode/sprintengine.test.cjs",
    "test:renderer:new-workspace-controllers": "esbuild src/renderer/src/components/workspace/newWorkspace/controllers/controllers.test.ts --bundle --platform=node --format=cjs --packages=bundle --external:react --external:react-dom --define:import.meta.env.DEV=false --loader:.css=empty --outfile=node_modules/.cache/multicode/new-workspace-controllers.test.cjs && node node_modules/.cache/multicode/new-workspace-controllers.test.cjs",
    "test:renderer:ui-accessibility-contracts": "esbuild src/renderer/src/components/ui/accessibility-contracts.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/accessibility-contracts.test.cjs && node node_modules/.cache/multicode/accessibility-contracts.test.cjs",
    "lint": "node scripts/lint-design-tokens.mjs && node scripts/lint-panel-composition.mjs && node scripts/lint-palette-contract.mjs && node scripts/lint-primitive-duplication.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:design-tokens:report": "node scripts/lint-design-tokens.mjs --report",
    "lint:panel-composition": "node scripts/lint-panel-composition.mjs",
    "lint:panel-composition:report": "node scripts/lint-panel-composition.mjs --report",
    "lint:palette-contract": "node scripts/lint-palette-contract.mjs",
    "lint:palette-contract:report": "node scripts/lint-palette-contract.mjs --report",
    "lint:primitive-duplication": "node scripts/lint-primitive-duplication.mjs",
    "lint:primitive-duplication:report": "node scripts/lint-primitive-duplication.mjs --report",
    "report:source-size": "node scripts/report-source-size.mjs",
    "verify:panels": "npm run lint && npm run test:renderer:switchboard-board && npm run test:renderer:ui-accessibility-contracts",
    "verify:app": "npm run typecheck && npm run lint && npm run test:main:git-branch-actions && npm run test:main:plugin-render && npm run test:main:plugin-registry && npm run test:main:module-host && npm run test:main:module-enablement && npm run test:shared:module-resolve && npm run test:shared:module-permissions && npm run test:shared:third-party-manifest && npm run test:main:module-signature && npm run test:main:user-module-registry && npm run test:main:trust-store && npm run test:renderer:bundled-ids && npm run test:renderer:onboarding-state && npm run test:shared:role-manifest && npm run test:main:sprintengine-role-registry && npm run test:shared:layout-template-manifest && npm run test:main:layout-template-registry && npm run test:main:agent-launch-render && npm run test:main:agent-stream-watcher && npm run test:main:mcp-config && npm run test:main:sprintengine-artifacts && npm run test:main:terminal-runtime && npm run test:renderer:markdown && npm run test:renderer:switchboard-board && npm run test:renderer:terminal-sessions && npm run test:renderer:ui-accessibility-contracts",
    "marketing:video:preview": "remotion studio src/remotion/index.ts",
    "marketing:video:poster": "remotion still src/remotion/index.ts SprintEngineProductHero marketing/assets/sprintengine-product-hero-poster.png --frame=420 --overwrite",
    "marketing:video:render": "remotion render src/remotion/index.ts SprintEngineProductHero marketing/assets/sprintengine-product-hero.mp4 --codec=h264 --overwrite",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "test:renderer:onboarding-state": "esbuild src/renderer/src/store/onboardingState.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/onboarding-state.test.cjs && node node_modules/.cache/multicode/onboarding-state.test.cjs"
  },
  "build": {
    "appId": "com.multicode",
    "productName": "Multicode",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Multicode-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "souls/**/*.py",
      "souls/prompts/**/*.md",
      "scripts/souls",
      "scripts/souls.cmd",
      "scripts/switchboard",
      "scripts/switchboard.cmd",
      "scripts/sprintengine",
      "scripts/sprintengine.cmd",
      "scripts/sprintengine_tool.py",
      "switchboard_core/**/*.py",
      "sprintengine_core/**/*.py",
      "sprintengine_mcp/**/*.py",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "scripts/multiloop_tool.py",
        "to": "scripts/multiloop_tool.py"
      },
      {
        "from": "multiloop_core",
        "to": "multiloop_core",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "scripts/sprintengine_tool.py",
        "to": "scripts/sprintengine_tool.py"
      },
      {
        "from": "scripts/souls",
        "to": "scripts/souls"
      },
      {
        "from": "scripts/souls.cmd",
        "to": "scripts/souls.cmd"
      },
      {
        "from": "scripts/sprintengine",
        "to": "scripts/sprintengine"
      },
      {
        "from": "scripts/sprintengine.cmd",
        "to": "scripts/sprintengine.cmd"
      },
      {
        "from": "scripts/switchboard",
        "to": "scripts/switchboard"
      },
      {
        "from": "scripts/switchboard.cmd",
        "to": "scripts/switchboard.cmd"
      },
      {
        "from": "switchboard_core",
        "to": "switchboard_core",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "sprintengine_core",
        "to": "sprintengine_core",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "sprintengine_mcp",
        "to": "sprintengine_mcp",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "souls",
        "to": "souls",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hooks",
        "to": "hooks",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/mcps",
        "to": "mcps",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skill-packs",
        "to": "skill-packs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sprintengine",
        "to": "resources/sprintengine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "conal-smith",
      "repo": "multicode"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "claude": "^0.1.1",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.8.3",
    "flexlayout-react": "^0.8.12",
    "immer": "^10.1.1",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.9",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@remotion/cli": "^4.0.464",
    "@tailwindcss/vite": "^4.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.464",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}
