{
  "name": "sprintengine-studio",
  "version": "0.4.0",
  "description": "Agent-first desktop IDE and sprint command centre that runs coding agent CLIs across parallel workspaces.",
  "author": "Conal Smith",
  "license": "FSL-1.1-Apache-2.0",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://sprintengine.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintengine/studio.git"
  },
  "bugs": {
    "url": "https://github.com/sprintengine/studio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build && node scripts/check-bundle-budget.mjs",
    "build:sdk": "tsc -p packages/module-sdk/tsconfig.json",
    "dist": "npm run runtimes:fetch && npm run build && electron-builder",
    "dist:win": "npm run runtimes:fetch -- --platform win32 && npm run build && electron-builder --win",
    "dist:mac": "npm run runtimes:fetch -- --platform darwin && npm run build && electron-builder --mac",
    "dist:linux": "npm run runtimes:fetch -- --platform linux && npm run build && electron-builder --linux",
    "runtimes:fetch": "node scripts/fetch-runtimes.mjs",
    "icons": "node scripts/generate-icons.js",
    "test": "node scripts/testing/run-tests.mjs",
    "test:all": "node scripts/testing/run-tests.mjs --all",
    "test:sdk:drift": "tsc -p packages/module-sdk/tsconfig.json && tsc -p packages/module-sdk/tsconfig.drift.json && esbuild packages/module-sdk/drift/sdk-drift-guard.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/sdk-drift-guard.cjs && node node_modules/.cache/multicode/sdk-drift-guard.cjs",
    "test:sdk:pack": "node scripts/verify-module-sdk-pack.mjs",
    "test:model-feed": "node scripts/check-model-feed-seed.mjs",
    "test:card-feed": "node scripts/check-card-feed-seed.mjs",
    "typecheck": "npm run typecheck:app",
    "typecheck:app": "tsc -b --noEmit --verbose",
    "typecheck:tests": "tsc -b tsconfig.tests.json --noEmit --verbose",
    "typecheck:all": "npm run typecheck:app && npm run typecheck:tests",
    "verify:app": "npm run typecheck && npm run lint && npm run test && npm run test:sdk:drift && npm run test:sdk:pack && npm run test:model-feed && npm run test:card-feed",
    "verify:marketplace-registry": "esbuild resources/marketplace/verify-marketplace.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/marketplace-registry-verify.cjs && node node_modules/.cache/multicode/marketplace-registry-verify.cjs",
    "verify:third-party-modules-e2e": "node scripts/testing/third-party-module-e2e.mjs",
    "verify:native-menu-conformance": "node scripts/testing/native-menu-conformance-pass.mjs",
    "verify:file-tree-cues": "node scripts/testing/file-tree-cues-pass.mjs",
    "lint": "node scripts/lint-design-tokens.mjs && node scripts/lint-panel-composition.mjs && node scripts/lint-palette-contract.mjs && node scripts/lint-primitive-duplication.mjs && node scripts/lint-door-surfaces.mjs && node scripts/lint-design-system-conformance.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:design-tokens:report": "node scripts/lint-design-tokens.mjs --report",
    "lint:panel-composition": "node scripts/lint-panel-composition.mjs",
    "lint:panel-composition:report": "node scripts/lint-panel-composition.mjs --report",
    "lint:palette-contract": "node scripts/lint-palette-contract.mjs",
    "lint:palette-contract:report": "node scripts/lint-palette-contract.mjs --report",
    "lint:primitive-duplication": "node scripts/lint-primitive-duplication.mjs",
    "lint:primitive-duplication:report": "node scripts/lint-primitive-duplication.mjs --report",
    "lint:door-surfaces": "node scripts/lint-door-surfaces.mjs",
    "catalogue:cli-entries": "esbuild resources/marketplace/generate-cli-entries.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/multicode/marketplace-cli-entries-generate.cjs && node node_modules/.cache/multicode/marketplace-cli-entries-generate.cjs",
    "sync:catalogue": "node scripts/sync-catalogue.mjs",
    "sync:model-feed": "node scripts/sync-model-feed.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "report:source-size": "node scripts/report-source-size.mjs",
    "postinstall": "node scripts/fix-node-pty-permissions.js"
  },
  "build": {
    "appId": "com.sprintengine.studio",
    "productName": "SprintEngine Studio",
    "directories": {
      "output": "dist"
    },
    "artifactName": "SprintEngine-Studio-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "souls/**/*.py",
      "scripts/souls",
      "scripts/souls.cmd",
      "scripts/sprintengine",
      "scripts/sprintengine.cmd",
      "scripts/sprintengine_tool.py",
      "sprintengine_core/**/*.py",
      "sprintengine_mcp/**/*.py",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/automation",
        "to": "automation",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/studio-plugin",
        "to": "studio-plugin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/sprintengine_tool.py",
        "to": "scripts/sprintengine_tool.py"
      },
      {
        "from": "scripts/souls",
        "to": "scripts/souls"
      },
      {
        "from": "scripts/souls.cmd",
        "to": "scripts/souls.cmd"
      },
      {
        "from": "scripts/sprintengine",
        "to": "scripts/sprintengine"
      },
      {
        "from": "scripts/sprintengine.cmd",
        "to": "scripts/sprintengine.cmd"
      },
      {
        "from": "sprintengine_core",
        "to": "sprintengine_core",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "sprintengine_mcp",
        "to": "sprintengine_mcp",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "souls",
        "to": "souls",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/model-feed.json",
        "to": "model-feed.json"
      },
      {
        "from": "resources/cards-feed.json",
        "to": "cards-feed.json"
      },
      {
        "from": "resources/hooks",
        "to": "hooks",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "resources/mcps",
        "to": "mcps",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/marketplace",
        "to": "marketplace",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/design-system",
        "to": "design-system",
        "filter": [
          "templates/**"
        ]
      },
      {
        "from": "resources/sprintengine",
        "to": "resources/sprintengine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/specialist-pack",
        "to": "resources/specialist-pack",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Multicode uses the microphone for voice dictation, transcribing your speech to text."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "sprintengine",
      "repo": "studio-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.202",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.3",
    "flexlayout-react": "^0.8.12",
    "immer": "^10.1.1",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.9",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}
