{
  "name": "@multicode/module-sdk",
  "version": "0.3.0",
  "description": "Published contract types and authoring CLI for building Multicode capability modules and BYO-CLI plugins: manifest, permissions, MainHost/RendererHost contributions, workspace creation, Automations providers, notifications, CLI plugin manifests, and signing.",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    }
  },
  "bin": {
    "multicode-module": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
