{
  "name": "{{id}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{displayName}} — a SprintEngine Studio extension ({{templateTitle}} template).",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer.tsx --bundle --format=esm --platform=browser --target=chrome130 --jsx=automatic --loader:.css=text --external:react --external:react-dom --external:react-dom/client --external:react/jsx-runtime --external:@monaco-editor/react --external:@sprintengine/module-sdk/ui --external:@sprintengine/module-sdk/surface --outfile=module/dist/renderer.mjs",
    "build:main": "esbuild src/main.ts --bundle --format=cjs --platform=node --target=node22 --external:electron --outfile=module/dist/main.cjs",
    "build": "npm run build:renderer && npm run build:main",
    "test": "node --test test/smoke.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run validate",
    "dev:install": "npm run build && node scripts/dev-install.mjs",
    "keygen": "sprintengine-module keygen --out \"$HOME/.sprintengine/keys/{{id}}.key\""
  },
  "devDependencies": {
    "@sprintengine/module-sdk": "^{{sdkVersion}}",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
