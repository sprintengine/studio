{
  "id": "{{id}}",
  "displayName": "{{displayName}}",
  "version": 1,
  "publisher": "{{publisher}}",
  "summary": "{{displayName}}, an extension for SprintEngine Studio.",
  "defaultEnabled": false,
  "source": "third-party",
  "engines": {
    "hostApi": 1
  },
  "permissions": [
    "conversation:operate",
    "ipc:invoke",
    "ipc:workspace-read"
  ],
  "dependsOn": [
    "agent-runtime"
  ],
  "entry": {
    "renderer": "dist/renderer.mjs",
    "main": "dist/main.cjs"
  }
}
