{
  "name": "{{id}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{displayName}} \u2014 a SprintEngine Studio extension ({{templateTitle}} template).",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:main": "esbuild src/main.ts --bundle --format=cjs --platform=node --target=node22 --external:electron --outfile=module/dist/main.cjs",
    "build": "npm run build:renderer --if-present && npm run build:main --if-present && node scripts/dev-install.mjs --no-install",
    "build:test": "esbuild \"test/**/*.test.ts\" --bundle --platform=node --format=esm --target=node22 --packages=external --jsx=automatic --loader:.css=text --outbase=test --outdir=test/.build --out-extension:.js=.mjs --log-level=warning",
    "test": "npm run build:test && node --import @sprintengine/module-sdk/testing/register --test test/smoke.test.mjs \"test/.build/**/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run validate",
    "dev:install": "npm run build && node scripts/dev-install.mjs",
    "keygen": "sprintengine-module keygen --out \"~/.sprintengine/keys/{{id}}.key\""
  },
  "devDependencies": {
    "@sprintengine/module-sdk": "^{{sdkVersion}}",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
