# Vendored runtimes (CPython + npm) fetched at build time by
# scripts/fetch-runtimes.mjs — large binaries, never committed.
resources/runtime/

# electron-vite temp config
electron.vite.config.*.mjs

# Local tool settings. `.claude/settings.json` is written by the Claude Code
# harness on whichever machine is running it — `enabledPlugins` records the
# plugins that machine happens to have installed — so it is local state, not
# project config.
.claude/settings.json
.claude/settings.local.json
.claude/*.lock
.grok/settings.json
.mcp.json
# ...except the one the app SHIPS. `.mcp.json` above is unanchored, so it matches
# at every depth, and the SprintEngine Studio plugin's own server declaration is
# a source file, not a generated workspace config.
!resources/studio-plugin/**/.mcp.json

# Backlog link cache: resolved link statuses, the agent terminal holding an item,
# module metadata bound to a live session. Every value is re-derived from the
# world, so deleting it costs a lookup and never data. It replaced
# `.multi-code/backlog/items.json`, which held the same volatile state in a
# TRACKED file and churned it on every resolve tick; the durable half now lives in
# each item's own markdown frontmatter.
.multi-code/backlog/cache/

# Debug Mode ephemeral state (one scratch file per agent terminal)
.multi-code/debug/
# Browser tab screenshots and element crops (browser-pane epic).
.multi-code/browser/

# Captured conversation transcripts and review state: the app writes these as it
# runs, in whatever workspace it has open — including this one. `backlog/config.json`
# next to them IS project configuration (it carries the `MC` item-key prefix) and
# stays tracked.
.multi-code/conversations/
.multi-code/review/

# Automations runtime state
.multi-code/automations/

# Sprint Engine runtime state
.multi-code/sprintengine/*
!.multi-code/sprintengine/README.md
!.multi-code/sprintengine/fixtures/
!.multi-code/sprintengine/fixtures/**
!.multi-code/sprintengine/evidence/
!.multi-code/sprintengine/evidence/**

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vendored third-party skill packs (Cloudflare, WorkOS, agents-sdk, wrangler…).
# Installed into the harness skill dirs by their own publishers and re-installable
# from them, so the checkout is a cache, not a source. Two skills beside them ARE
# authored here and stay tracked — `sprintengine`, which does not exist anywhere
# else in the tree — which is why these are named one by one rather than the
# whole `.agents/skills/` tree being ignored. `prototype` is a third-party skill too (its marker records
# `github:mattpocock/skills`) but stays tracked pending a decision on where it
# should live.
.agents/skills/agents-sdk/
.agents/skills/cloudflare-email-service/
.agents/skills/cloudflare-one/
.agents/skills/cloudflare-one-migrations/
.agents/skills/durable-objects/
.agents/skills/sandbox-sdk/
.agents/skills/turnstile-spin/
.agents/skills/web-perf/
.agents/skills/workers-best-practices/
.agents/skills/workos/
.agents/skills/workos-widgets/
.agents/skills/wrangler/

# SprintEngine Studio's own plugin, and the skill packs its installer copies into
# each harness's skill dir. Both are install output: every copied skill carries an
# `installedAt` stamp in its .multicode-skill.json, and the source they are built
# from is `resources/studio-plugin/`, which IS tracked.
.multicode/studio-plugin/
.agents/skills/studio-*/
.claude/skills/studio-*/
.grok/skills/studio-*/
.opencode/skills/studio-*/

# Same installer, same `installedAt` stamp, different naming: the BUILT-IN skills
# it copies out of `resources/studio-plugin/studio-skills/skills/` carry no
# `studio-` prefix, so they have to be named one by one. Their markers say
# `"source": "multicode-builtin"`. `.agents/skills/workspace-knowledge/` is the
# proof they are output and not source — its tracked copy was stamped 2026-05-19
# and had since drifted from the tracked file it was copied from. `use-railway`
# no longer HAS a source: it was retired with the other third-party-tool skills
# on 2026-09-08, so its rule only keeps an old install from reappearing.
.agents/skills/debug/
.agents/skills/review-guide/
.agents/skills/use-railway/
.agents/skills/workspace-knowledge/
.claude/skills/debug/
.claude/skills/review-guide/
.grok/skills/debug/
.grok/skills/review-guide/
.opencode/skills/debug/
.opencode/skills/review-guide/

# Agent-state hook files the studio writes into this workspace when it opens
# it, with the socket and reporter paths of the machine substituted in. They
# are install-time output, not source: the templates live under resources/.
.grok/hooks/multicode-agent-state.json
.opencode/plugin/multicode-agent-state.js
# …and the reporter script itself. `AGENT_STATE_HOOK_SCRIPT_REL` in
# src/main/agent-state.ts is `.multicode/hooks/agent-state.mjs`: the app copies
# `resources/hooks/multicode-agent-state.mjs` there byte for byte when it opens a
# workspace, so the tracked copy was a second, staler original.
.multicode/hooks/

# Leftover app metadata from the retired Design Wizard (deleted 2026-09-08):
# its idea seed and inspiration drops. Nothing writes here any more, and the
# files on an existing workspace are deliberately left alone, so the ignore
# stays until those workspaces are gone.
.guided-brief/

# Scratch output of the Playwright MCP server an agent session may run against
# this checkout (screenshots, console logs). Not the retired Playwright test
# harnesses, which are gone; this is another tool's cache.
.playwright-mcp/
