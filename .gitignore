# Vendored runtimes (CPython + npm) fetched at build time by
# scripts/fetch-runtimes.mjs — large binaries, never committed.
resources/runtime/

# electron-vite temp config
electron.vite.config.*.mjs

# Local tool settings. `.claude/settings.json` is written by the Claude Code
# harness on whichever machine is running it — `enabledPlugins` records the
# plugins that machine happens to have installed — so it is local state, not
# project config.
.claude/settings.json
.claude/settings.local.json
.claude/*.lock
.grok/settings.json
.mcp.json
# ...except the one the app SHIPS. `.mcp.json` above is unanchored, so it matches
# at every depth, and the SprintEngine Studio plugin's own server declaration is
# a source file, not a generated workspace config
# (backlog/2026-09-06-sprintengine-studio-ships-as-a-plugin.md).
!resources/studio-plugin/**/.mcp.json

# Backlog link cache: resolved link statuses, the agent terminal holding an item,
# module metadata bound to a live session. Every value is re-derived from the
# world, so deleting it costs a lookup and never data. It replaced
# `.multi-code/backlog/items.json`, which held the same volatile state in a
# TRACKED file and churned it on every resolve tick; the durable half now lives in
# each item's own markdown frontmatter.
.multi-code/backlog/cache/

# Debug Mode ephemeral state (one scratch file per agent terminal)
.multi-code/debug/
# Browser tab screenshots and element crops (browser-pane epic).
.multi-code/browser/

# Switchboard runtime state
.multi-code/switchboard/
# Captured conversation transcripts and review state: the app writes these as it
# runs, in whatever workspace it has open — including this one. `backlog/config.json`
# next to them IS project configuration (it carries the `MC` item-key prefix) and
# stays tracked.
.multi-code/conversations/
.multi-code/review/

# Automations runtime state
.multi-code/automations/

# Sprint Engine runtime state
.multi-code/sprintengine/*
!.multi-code/sprintengine/README.md
!.multi-code/sprintengine/fixtures/
!.multi-code/sprintengine/fixtures/**
!.multi-code/sprintengine/evidence/
!.multi-code/sprintengine/evidence/**

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vendored third-party skill packs (Cloudflare, WorkOS, agents-sdk, wrangler…).
# Installed into the harness skill dirs by their own publishers and re-installable
# from them, so the checkout is a cache, not a source. The first-party skills that
# live beside them — backlog, prototype, review-guide, sprintengine,
# workspace-knowledge, use-railway, multicode-electron-playwright — ARE authored
# here and stay tracked, which is why these are named one by one rather than the
# whole `.agents/skills/` tree being ignored.
.agents/skills/agents-sdk/
.agents/skills/cloudflare-email-service/
.agents/skills/cloudflare-one/
.agents/skills/cloudflare-one-migrations/
.agents/skills/durable-objects/
.agents/skills/sandbox-sdk/
.agents/skills/turnstile-spin/
.agents/skills/web-perf/
.agents/skills/workers-best-practices/
.agents/skills/workos/
.agents/skills/workos-widgets/
.agents/skills/wrangler/

# SprintEngine Studio's own plugin, and the skill packs its installer copies into
# each harness's skill dir. Both are install output: every copied skill carries an
# `installedAt` stamp in its .multicode-skill.json, and the source they are built
# from is `resources/studio-plugin/`, which IS tracked.
.multicode/studio-plugin/
.agents/skills/studio-*/
.claude/skills/studio-*/
.grok/skills/studio-*/
.opencode/skills/studio-*/
